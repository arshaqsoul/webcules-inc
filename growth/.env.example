# Copy to growth/.env.local (gitignored) and fill in. Never commit real values.
GROWTH_STAGING_URL=https://snap-staging.webcules.com
GROWTH_STAGING_EMAIL=
GROWTH_STAGING_PASSWORD=
# Addresses a take may send real email to (comma separated). Takes that send email refuse any other recipient.
GROWTH_SAFE_EMAILS=
# ComfyUI server used to generate music (ACE-Step 1.5). Default http://127.0.0.1:8188
GROWTH_COMFY_URL=
# Private R2 bucket that keeps finished reels, covers and music in sync across PCs (sync.mjs). Default webcules-growth
GROWTH_R2_BUCKET=
# Optional overrides
# GROWTH_STATE_DIR=
# GROWTH_LOCK_DIR=
