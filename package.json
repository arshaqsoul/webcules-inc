{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "forge:new": "node tools/forge/new.mjs",
    "forge:analyze": "node tools/forge/analyze.mjs",
    "webcules-forge-w-analyse": "node tools/forge/webcules-forge-w-analyse.mjs",
    "forge:record": "node tools/forge/record.mjs",
    "forge:approve": "node tools/forge/approve.mjs",
    "forge:list": "node tools/forge/list.mjs",
    "forge:deploy": "node tools/forge/deploy.mjs"
  },
  "devDependencies": {
    "@webcules/eslint-config": "workspace:*",
    "@webcules/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}
