# Local dev secrets for the landing worker (read by the wrangler platform
# proxy). Copy to .dev.vars and fill in real values — .dev.vars is gitignored.
# Auth fails closed at startup without a secret (lib/auth.server.ts).

# REQUIRED. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Without a Resend key, sign-in emails print to the console in local
# dev ONLY; in production, sign-in fails visibly instead of logging credentials.
RESEND_API_KEY=

EMAIL_FROM=Webcules <noreply@resend.dev>
BETTER_AUTH_URL=http://localhost:3000
