# Build-time (inlined) public env for production builds — runtime values live in wrangler vars/secrets
# SERVER_URL points at the CMS origin (media URLs, OG images, auth endpoints)
NEXT_PUBLIC_SERVER_URL=https://cms.webcules.com
# BASE_URL is this site's own origin (metadataBase, sitemaps, robots)
NEXT_PUBLIC_BASE_URL=https://webcules.com
