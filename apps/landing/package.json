{
  "name": "landing",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build-registry.mjs && next build",
    "deploy": "node scripts/build-registry.mjs && opennextjs-cloudflare build && node scripts/fix-worker-manifest.mjs && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 execute webcules-cms --local --file=./migrations/0001_auth.sql",
    "registry:build": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@webcules/payload": "workspace:*",
    "@webcules/ui": "workspace:*",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.22",
    "geist": "^1.3.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.25",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "payload": "3.58.0",
    "prism-react-renderer": "^2.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-lottie-player": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "1.54.1",
    "@types/node": "22.5.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@webcules/eslint-config": "workspace:^",
    "@webcules/typescript-config": "workspace:*",
    "typescript": "5.8.3",
    "wrangler": "^4.125.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
