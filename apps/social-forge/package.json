{
  "name": "@webcules/social-forge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Webcules motion-component forge: reference video → reusable component (packages/ui) → shadcn registry + manual download → FB/IG post pack. Local-first; the demo gallery serves the real components for recording.",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "astro preview --port 4322",
