# Database — local SQLite file by default. Swap for a Turso URL to go hosted later.
DATABASE_URL=file:./data/dashboard.db

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4400

# Stripe (optional — card checkout + $20/mo maintenance subscriptions).
# Leave empty to run in manual/e-Transfer mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:4400

# Where forge projects live (for the /forge import scanner)
FORGE_ROOT=C:/Users/arsha/Documents/projects/webcules
