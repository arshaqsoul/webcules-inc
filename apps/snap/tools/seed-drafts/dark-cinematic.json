          { "assetId": "wedding-04", "x": 57, "y": 30, "w": 25, "rotation": 3, "z": 3, "focal": { "x": 0.5, "y": 0.3 } },
          { "assetId": "wedding-03", "x": 76, "y": 10, "w": 22, "rotation": -3, "z": 1, "focal": { "x": 0.5, "y": 0.5 } }
