---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  class?: string;
}
const { id, eyebrow, title, class: className } = Astro.props;
---
<section id={id} class={`relative py-28 md:py-36 ${className ?? ""}`}>
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {title && (
      <h2 class="mt-4 max-w-3xl font-display text-[clamp(2.2rem,5vw,4rem)] leading-[1.02] font-semibold tracking-[-0.03em]">
        {title}
      </h2>
    )}
    <div class="mt-14">
      <slot />
    </div>
  </div>
</section>
