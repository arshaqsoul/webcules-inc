---
import { site } from "../data/site";
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-ink/60 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-10">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">
      {site.name}
    </a>
    <div class="hidden items-center gap-8 md:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="text-sm text-muted transition-colors duration-300 hover:text-fg"
        >
          {item.label}
        </a>
      ))}
    </div>
    <a
      href={site.cta.href}
      class="group relative inline-flex items-center overflow-hidden rounded-full bg-fg px-4 py-1.5 text-sm font-medium text-ink transition-transform duration-300 hover:scale-[1.04] active:scale-[0.98]"
    >
      {site.cta.label}
    </a>
  </nav>
</header>
