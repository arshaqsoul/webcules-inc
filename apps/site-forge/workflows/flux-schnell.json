{
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "flux1-schnell-fp8.safetensors" } },
  "2": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["1", 1], "text": "{{prompt}}" } },
  "3": { "class_type": "EmptySD3LatentImage", "inputs": { "width": {{width}}, "height": {{height}}, "batch_size": 1 } },
  "4": { "class_type": "KSampler", "inputs": { "model": ["1", 0], "positive": ["2", 0], "negative": ["2", 0], "latent_image": ["3", 0], "seed": {{seed}}, "steps": {{steps}}, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "denoise": 1 } },
  "5": { "class_type": "VAEDecode", "inputs": { "samples": ["4", 0], "vae": ["1", 2] } },
  "6": { "class_type": "SaveImage", "inputs": { "images": ["5", 0], "filename_prefix": "{{prefix}}" } }
}
