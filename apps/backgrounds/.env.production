# Build-time (inlined) public env for production builds — runtime values live in wrangler vars/secrets
# SERVER_URL points at the CMS origin (media URLs, downloads, auth endpoints)
NEXT_PUBLIC_SERVER_URL=https://cms.webcules.com
# APP_URL / BASE_URL are this site's own origin
NEXT_PUBLIC_APP_URL=https://backgrounds.webcules.com
NEXT_PUBLIC_BASE_URL=https://backgrounds.webcules.com
