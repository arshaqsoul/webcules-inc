{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arshaq-portfolio",
  "compatibility_date": "2025-08-15",
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "arshaq.webcules.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
